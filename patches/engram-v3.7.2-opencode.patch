@@ -0,0 +1,68 @@
+package mcp
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"regexp"
+	"strings"
+)
+
+// Reuse the deployed tool_name encoding. This is a label, not authentication.
+var sourceAgentPattern = regexp.MustCompile(`^[A-Za-z0-9_.-]{1,120}$`)
+var openCodeSessionPattern = regexp.MustCompile(`^ses_[A-Za-z0-9]{1,160}$`)
+var canonicalSummaryIDPattern = regexp.MustCompile(`^[a-z0-9_-]+$`)
+
+func sourceAgentLabel(raw string) string {
+	name, present := strings.CutPrefix(raw, "agent:")
+	if present && sourceAgentPattern.MatchString(name) {
+		return name
+	}
+	return ""
+}
+
+func sourceAgentArg(args map[string]any) (encoded string, present, valid bool) {
+	v, present := args["source_agent"]
+	if !present {
+		return "", false, true
+	}
+	raw, ok := v.(string)
+	if !ok {
+		return "", true, false
+	}
+	label := strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(raw), "agent:"))
+	if label == "" {
+		return "", true, true
+	}
+	if !sourceAgentPattern.MatchString(label) {
+		return "", true, false
+	}
+	return "agent:" + label, true, true
+}
+
+func openCodeSummaryTopic(sessionID string) string {
+	sessionID = strings.TrimSpace(sessionID)
+	key := "session/" + sessionID + "/summary"
+	if len(key) <= 120 && canonicalSummaryIDPattern.MatchString(sessionID) {
+		return key
+	}
+	digest := sha256.Sum256([]byte(sessionID))
+	return "session/id-" + hex.EncodeToString(digest[:16]) + "/summary"
+}
+
+func openCodeInstructions(allowlist map[string]bool) (string, bool) {
+	const tools = "mem_context, mem_current_project, mem_doctor, mem_get_observation, mem_judge, mem_review, mem_save, mem_search, mem_session_summary, mem_suggest_topic_key, mem_update"
+	names := strings.Split(tools, ", ")
+	if len(allowlist) != len(names) {
+		return "", false
+	}
+	for _, name := range names {
+		if !allowlist[name] {
+			return "", false
+		}
+	}
+	return "Engram provides curated durable memory across sessions.\n\nREGISTERED TOOLS:\n" + tools + `
+
+Follow the client's role authority and local memory rules. The listing is not a permission grant. Reuse sufficient context; do not retrieve, save or summarize by routine. Save verified durable findings with capture_prompt=false for automatic saves. Summaries are for new continuity or an explicit local requirement. Never persist secrets, private content, raw prompts or tool logs, or use CLI as a bypass.
+
+After mem_save, inspect judgment_required. Each candidate has its own candidates[].judgment_id: call mem_judge for each, never with the top-level ID. Ask the user for confidence below 0.7 or for supersedes/conflicts_with on architecture, policy or decisions. Otherwise record related, compatible, scoped or not_conflict as appropriate. If blocked by client permissions, leave it pending and report it.`, true
+}
