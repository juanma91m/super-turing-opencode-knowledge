+func sessionSummaryTopicKey(sessionID string) string {
+	sessionID = strings.TrimSpace(sessionID)
+	candidate := fmt.Sprintf("session/%s/summary", sessionID)
+	if len(candidate) <= 120 && isCanonicalSummarySessionID(sessionID) {
+		return candidate
+	}
+
+	// Store topic keys are lowercase and capped at 120 bytes. Hash only IDs that
+	// would be normalized ambiguously so distinct explicit session IDs cannot
+	// collapse while standard OpenCode IDs keep the readable canonical format.
+	digest := sha256.Sum256([]byte(sessionID))
+	return fmt.Sprintf("session/id-%s/summary", hex.EncodeToString(digest[:16]))
+}
+
+func isCanonicalSummarySessionID(sessionID string) bool {
+	if sessionID == "" {
+		return false
+	}
+	for _, char := range sessionID {
+		if (char >= 'a' && char <= 'z') || (char >= '0' && char <= '9') || char == '-' || char == '_' {
+			continue
+		}
+		return false
+	}
+	return true
+}
