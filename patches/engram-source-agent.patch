+	raw := strings.TrimSpace(*toolName)
+	if !strings.HasPrefix(raw, "agent:") {
+		return ""
+	}
+	label := strings.TrimSpace(strings.TrimPrefix(raw, "agent:"))
+	if label == "" {
+		return ""
+	}
+	return fmt.Sprintf(" [source: %s]", label)
