+func TestSourceAgentToolNameFilteringContextAndUpdate(t *testing.T) {
+	s := newTestStore(t)
+
+	if err := s.CreateSession("s-source-agent", "engram", "/tmp/engram"); err != nil {
+		t.Fatalf("create session: %v", err)
+	}
+
+	frontendID, err := s.AddObservation(AddObservationParams{
+		SessionID: "s-source-agent",
+		Type:      "pattern",
+		Title:     "Frontend cache pattern",
+		Content:   "cache invalidation strategy for react queries",
+		ToolName:  "agent:frontend-web-developer",
+		Project:   "engram",
+		Scope:     "project",
+		TopicKey:  "pattern/frontend-cache",
+	})
+	if err != nil {
+		t.Fatalf("add frontend observation: %v", err)
+	}
+	_, err = s.AddObservation(AddObservationParams{
+		SessionID: "s-source-agent",
+		Type:      "pattern",
+		Title:     "Backend cache pattern",
+		Content:   "cache invalidation strategy for service queries",
+		ToolName:  "agent:backend-java-developer",
+		Project:   "engram",
+		Scope:     "project",
+	})
+	if err != nil {
+		t.Fatalf("add backend observation: %v", err)
+	}
+	_, err = s.AddObservation(AddObservationParams{
+		SessionID: "s-source-agent",
+		Type:      "tool_use",
+		Title:     "Passive capture",
+		Content:   "passive metadata must remain tool metadata",
+		ToolName:  "mcp-passive",
+		Project:   "engram",
+		Scope:     "project",
+	})
+	if err != nil {
+		t.Fatalf("add passive observation: %v", err)
+	}
+
+	results, err := s.Search("cache", SearchOptions{
+		Project:  "engram",
+		Scope:    "project",
+		ToolName: "agent:frontend-web-developer",
+		Limit:    10,
+	})
+	if err != nil {
+		t.Fatalf("search by source agent tool name: %v", err)
+	}
+	if len(results) != 1 || results[0].ID != frontendID {
+		t.Fatalf("expected only frontend observation, got %#v", results)
+	}
+
+	directResults, err := s.Search("pattern/frontend-cache", SearchOptions{
+		Project:  "engram",
+		ToolName: "agent:frontend-web-developer",
+		Limit:    10,
+	})
+	if err != nil {
+		t.Fatalf("search direct topic key by source agent: %v", err)
+	}
+	if len(directResults) != 1 || directResults[0].ID != frontendID {
+		t.Fatalf("expected direct topic-key result for frontend source, got %#v", directResults)
+	}
+
+	ctx, err := s.FormatContext("engram", "project")
+	if err != nil {
+		t.Fatalf("format context: %v", err)
+	}
+	if !strings.Contains(ctx, "[source: frontend-web-developer]") {
+		t.Fatalf("expected source agent metadata in context, got %q", ctx)
+	}
+	if strings.Contains(ctx, "[source: mcp-passive]") {
+		t.Fatalf("traditional tool metadata must not be presented as source agent, got %q", ctx)
+	}
+
+	updatedToolName := "agent:reviewer"
+	updated, err := s.UpdateObservation(frontendID, UpdateObservationParams{ToolName: &updatedToolName})
+	if err != nil {
+		t.Fatalf("update source agent tool name: %v", err)
+	}
+	if updated.ToolName == nil || *updated.ToolName != updatedToolName {
+		t.Fatalf("expected updated tool name %q, got %#v", updatedToolName, updated.ToolName)
+	}
+
+	clearedToolName := ""
+	updated, err = s.UpdateObservation(frontendID, UpdateObservationParams{ToolName: &clearedToolName})
+	if err != nil {
+		t.Fatalf("clear source agent tool name: %v", err)
+	}
+	if updated.ToolName != nil {
+		t.Fatalf("expected cleared tool name, got %#v", updated.ToolName)
+	}
+}
