+func sessionSummaryTopicKey(sessionID string) string {
+	sessionID = strings.TrimSpace(sessionID)
+	candidate := fmt.Sprintf("session/%s/summary", sessionID)
+	if len(candidate) <= 120 && isCanonicalSummarySessionID(sessionID) {
+		return candidate
+	}
+
+	// Store topic keys are lowercase and capped at 120 bytes. Hash only IDs that
+	// would be normalized ambiguously so distinct explicit session IDs cannot
+	// collapse while standard OpenCode IDs keep the readable canonical format.
+	digest := sha256.Sum256([]byte(sessionID))
+	return fmt.Sprintf("session/id-%s/summary", hex.EncodeToString(digest[:16]))
+}
+
+func isCanonicalSummarySessionID(sessionID string) bool {
+	if sessionID == "" {
+		return false
+	}
+	for _, char := range sessionID {
+		if (char >= 'a' && char <= 'z') || (char >= '0' && char <= '9') || char == '-' || char == '_' {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
 func handleSessionStart(s *store.Store, cfg MCPConfig, activity *SessionActivity) server.ToolHandlerFunc {
 	return func(ctx context.Context, req mcp.CallToolRequest) (*mcp.CallToolResult, error) {
 		id, _ := req.GetArguments()["id"].(string)
@@ -2959,6 +3042,36 @@ func defaultSessionID(project string) string {
 	return "manual-save-" + project
 }
 
+func normalizeSourceAgent(sourceAgent string) string {
+	raw := strings.TrimSpace(sourceAgent)
+	if raw == "" {
+		return ""
+	}
+	label := raw
+	if strings.HasPrefix(raw, "agent:") {
+		label = strings.TrimSpace(strings.TrimPrefix(raw, "agent:"))
+	}
+	if label == "" {
+		return ""
+	}
+	return "agent:" + label
+}
+
+func sourceAgentLabel(toolName *string) string {
+	if toolName == nil {
+		return ""
+	}
+	return sourceAgentLabelFromString(*toolName)
+}
+
+func sourceAgentLabelFromString(value string) string {
+	raw := strings.TrimSpace(value)
+	if !strings.HasPrefix(raw, "agent:") {
+		return ""
+	}
+	return strings.TrimSpace(strings.TrimPrefix(raw, "agent:"))
+}
