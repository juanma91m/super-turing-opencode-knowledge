+// NewReadOnly opens an existing Engram database without creating directories,
+// running migrations, repairing journals, or otherwise changing persistent
+// state. It is intended for diagnostic and dry-run command paths only.
+func NewReadOnly(cfg Config) (*Store, error) {
+	if !filepath.IsAbs(cfg.DataDir) {
+		return nil, fmt.Errorf("engram: data directory must be an absolute path, got %q — set ENGRAM_DATA_DIR or ensure your home directory is resolvable", cfg.DataDir)
+	}
+
+	dbPath := filepath.Join(cfg.DataDir, "engram.db")
+	if _, err := os.Stat(dbPath); err != nil {
+		return nil, fmt.Errorf("engram: open read-only database: %w", err)
+	}
+	dsn := &url.URL{Scheme: "file", Path: filepath.ToSlash(dbPath)}
+	query := dsn.Query()
+	query.Set("mode", "ro")
+	query.Add("_pragma", "query_only(1)")
+	query.Add("_pragma", "foreign_keys(1)")
+	query.Add("_pragma", "busy_timeout(5000)")
+	dsn.RawQuery = query.Encode()
+
+	db, err := openDB("sqlite", dsn.String())
+	if err != nil {
+		return nil, fmt.Errorf("engram: open read-only database: %w", err)
+	}
+	db.SetMaxOpenConns(1)
+	if err := db.Ping(); err != nil {
+		_ = db.Close()
+		return nil, fmt.Errorf("engram: open read-only database: %w", err)
+	}
+	return &Store{db: db, cfg: cfg, hooks: defaultStoreHooks(), readOnly: true}, nil
+}
