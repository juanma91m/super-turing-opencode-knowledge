+				}
+				_ = s.Close()
+				// Enrollment backfills canonical rows, so add one legacy row after it.
+				seedDoctorPendingMutation(t, cfg, project, store.SyncEntitySession, "legacy-s1", store.SyncOpUpsert, `{"id":"legacy-s1","project":"legacy-project"}`)
+			}
+
+			before := snapshotApplicationTables(t, cfg)
+			withArgs(t, "engram", "doctor", "--json", "--project", project, "--check", "sync_mutation_required_fields")
+			stdout, stderr := captureOutput(t, func() { cmdDoctor(cfg) })
+			if stderr != "" {
+				t.Fatalf("stderr=%q", stderr)
+			}
+			if after := snapshotApplicationTables(t, cfg); after != before {
+				t.Fatalf("doctor mutated application tables: before=%s after=%s", before, after)
+			}
+
+			var report map[string]any
+			if err := json.Unmarshal([]byte(stdout), &report); err != nil {
+				t.Fatalf("doctor JSON invalid: %v\n%s", err, stdout)
+			}
+			if report["status"] != tc.wantStatus {
+				t.Fatalf("status=%v want=%s report=%v", report["status"], tc.wantStatus, report)
+			}
+			check := report["checks"].([]any)[0].(map[string]any)
+			if check["result"] != tc.wantResult || check["severity"] != tc.wantLevel {
+				t.Fatalf("unexpected check classification: %v", check)
+			}
+			finding := check["findings"].([]any)[0].(map[string]any)
+			evidence := finding["evidence"].(map[string]any)
+			if evidence["project_enrolled"] != tc.enrolled || len(evidence["payload_sha256"].(string)) != 64 {
+				t.Fatalf("unexpected safe evidence: %v", evidence)
+			}
+			if strings.Contains(stdout, `"payload"`) || strings.Contains(stdout, "/work/legacy-project") {
+				t.Fatalf("doctor JSON leaked payload content: %s", stdout)
+			}
+		})
+	}
+}
+
+func seedLegacySessionMutation(t *testing.T, cfg store.Config, project string) {
+	t.Helper()
+	seedDoctorSession(t, cfg, "legacy-s1", project, "/work/"+project)
+	seedDoctorPendingMutation(t, cfg, project, store.SyncEntitySession, "legacy-s1", store.SyncOpUpsert, `{"id":"legacy-s1","project":"`+project+`"}`)
+}
+
+func snapshotApplicationTables(t *testing.T, cfg store.Config) string {
+	t.Helper()
+	dsn := "file:" + filepath.ToSlash(filepath.Join(cfg.DataDir, "engram.db")) + "?mode=ro"
+	db, err := sql.Open("sqlite", dsn)
+	if err != nil {
+		t.Fatalf("open read-only snapshot: %v", err)
+	}
+	defer db.Close()
+
+	tableRows, err := db.Query(`SELECT name FROM sqlite_schema WHERE type = 'table' ORDER BY name`)
+	if err != nil {
+		t.Fatalf("list tables: %v", err)
+	}
+	var tables []string
+	for tableRows.Next() {
+		var table string
+		if err := tableRows.Scan(&table); err != nil {
+			_ = tableRows.Close()
+			t.Fatalf("scan table: %v", err)
+		}
+		tables = append(tables, table)
+	}
+	if err := tableRows.Close(); err != nil {
+		t.Fatalf("close table rows: %v", err)
+	}
+
+	h := sha256.New()
+	for _, table := range tables {
+		quoted := `"` + strings.ReplaceAll(table, `"`, `""`) + `"`
+		rows, err := db.Query("SELECT * FROM " + quoted)
+		if err != nil {
+			t.Fatalf("snapshot table %s: %v", table, err)
+		}
+		columns, err := rows.Columns()
+		if err != nil {
+			_ = rows.Close()
+			t.Fatalf("columns for %s: %v", table, err)
+		}
+		var encodedRows []string
+		for rows.Next() {
+			values := make([]any, len(columns))
+			pointers := make([]any, len(columns))
+			for i := range values {
+				pointers[i] = &values[i]
+			}
+			if err := rows.Scan(pointers...); err != nil {
+				_ = rows.Close()
+				t.Fatalf("scan %s: %v", table, err)
+			}
+			parts := make([]string, len(values))
+			for i, value := range values {
+				switch typed := value.(type) {
+				case []byte:
+					parts[i] = "bytes:" + hex.EncodeToString(typed)
+				default:
+					parts[i] = fmt.Sprintf("%T:%v", value, value)
+				}
+			}
+			encodedRows = append(encodedRows, strings.Join(parts, "\x1f"))
+		}
+		if err := rows.Err(); err != nil {
+			_ = rows.Close()
+			t.Fatalf("iterate %s: %v", table, err)
+		}
+		if err := rows.Close(); err != nil {
+			t.Fatalf("close %s rows: %v", table, err)
+		}
+		sort.Strings(encodedRows)
+		_, _ = fmt.Fprintf(h, "%s\n%s\n", table, strings.Join(encodedRows, "\n"))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
