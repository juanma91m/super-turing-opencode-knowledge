+func TestScanProject_Semantic_DryRunDoesNotPersist(t *testing.T) {
+	s := newTestStore(t)
+	seedSimilarPair(t, s, "sem-dry-run-project")
+
+	runner := &routingRunner{runners: []SemanticRunner{&verdictRunner{
+		verdict: SemanticVerdict{
+			Relation:   "compatible",
+			Confidence: 0.9,
+			Reasoning:  "both discuss JWT auth",
+			Model:      "haiku",
+		},
+	}}}
+
+	beforeRelations, err := s.CountRelations(ListRelationsOptions{Project: "sem-dry-run-project"})
+	if err != nil {
+		t.Fatalf("CountRelations before scan: %v", err)
+	}
+	beforeMutations, err := s.CountRelationSyncMutations()
+	if err != nil {
+		t.Fatalf("CountRelationSyncMutations before scan: %v", err)
+	}
+
+	result, err := s.ScanProject(ScanOptions{
+		Project:        "sem-dry-run-project",
+		Apply:          false,
+		Semantic:       true,
+		Concurrency:    1,
+		TimeoutPerCall: 5 * time.Second,
+		MaxSemantic:    10,
+		Runner:         runner,
+		BuildPrompt:    identityPromptBuilder,
+	})
+	if err != nil {
+		t.Fatalf("ScanProject: %v", err)
+	}
+	if !result.DryRun {
+		t.Fatal("expected DryRun=true")
+	}
+	if runner.callIdx == 0 {
+		t.Fatal("expected dry-run to evaluate at least one semantic candidate")
+	}
+
+	afterRelations, err := s.CountRelations(ListRelationsOptions{Project: "sem-dry-run-project"})
+	if err != nil {
+		t.Fatalf("CountRelations after scan: %v", err)
+	}
+	afterMutations, err := s.CountRelationSyncMutations()
+	if err != nil {
+		t.Fatalf("CountRelationSyncMutations after scan: %v", err)
+	}
+	if afterRelations != beforeRelations {
+		t.Errorf("semantic dry-run persisted relations: before=%d after=%d", beforeRelations, afterRelations)
+	}
+	if afterMutations != beforeMutations {
+		t.Errorf("semantic dry-run enqueued relation sync mutations: before=%d after=%d", beforeMutations, afterMutations)
+	}
+}
