# Copy to server/.env, replace every placeholder and keep mode 0600.
ENGRAM_REF=1dafc0f63051b2214100f7bd801357e4aab61c26
ENGRAM_VERSION=1.20.1-0.20260814074340-1dafc0f63051+addon

POSTGRES_USER=engram
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=engram_cloud

ENGRAM_CLOUD_TOKEN=replace-with-a-different-random-hex
ENGRAM_CLOUD_ADMIN=replace-with-a-different-random-hex
ENGRAM_JWT_SECRET=replace-with-a-different-random-hex
ENGRAM_CLOUD_ALLOWED_PROJECTS=replace-with-explicit-existing-projects

# 127.0.0.1 is safe for same-host validation. Use a Tailscale address when
# remote clients need access; do not expose this service directly to Internet.
ENGRAM_CLOUD_BIND_ADDRESS=127.0.0.1
ENGRAM_CLOUD_PORT=18080
